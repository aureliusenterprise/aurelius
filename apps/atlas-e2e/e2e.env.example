# Copy to e2e.env (never commit it) and fill in. URL of the Aurelius frontend including the trailing slash.
# A stack on this PC is reached from the test container as host.docker.internal, e.g.
# E2E_BASE_URL=http://host.docker.internal:8080/aurelius/atlas/
E2E_BASE_URL=https://aurelius.example.com/aurelius/atlas/
E2E_INSECURE=false
# Keycloak users with the realm roles ROLE_ADMIN, DATA_STEWARD and DATA_SCIENTIST
E2E_ADMIN_USER=
E2E_ADMIN_PASSWORD=
E2E_STEWARD_USER=
E2E_STEWARD_PASSWORD=
E2E_SCIENTIST_USER=
E2E_SCIENTIST_PASSWORD=
