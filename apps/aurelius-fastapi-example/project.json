{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": ["aurelius-dev-keycloak", "aurelius-dev-postgres", "aurelius-example", "aurelius-sdk"],
    "name": "aurelius-fastapi-example",
    "projectType": "application",
    "sourceRoot": "{projectRoot}/aurelius_fastapi_example",
    "tags": [],
    "targets": {
        "serve": {
            "continuous": true,
            "dependsOn": [
                { "target": "decrypt" },
                { "projects": ["aurelius-dev-keycloak", "aurelius-dev-postgres"], "target": "serve" }
            ],
            "executor": "@nxlv/python:run-commands",
            "metadata": {
                "description": "Serve the application on a local development server"
            },
            "options": {
                "command": "python -m aurelius_fastapi_example"
            }
        }
    }
}
