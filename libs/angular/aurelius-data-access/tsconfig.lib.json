{
    "compilerOptions": {
        "declaration": true,
        "declarationMap": true,
        "inlineSources": true,
        "outDir": "../../../dist/out-tsc",
        "types": []
    },
    "exclude": [
        "src/**/*.spec.ts",
        "src/test-setup.ts",
        "jest.config.ts",
        "src/**/*.test.ts",
        "vite.config.ts",
        "vite.config.mts",
        "vitest.config.ts",
        "vitest.config.mts",
        "src/**/*.test.tsx",
        "src/**/*.spec.tsx",
        "src/**/*.test.js",
        "src/**/*.spec.js",
        "src/**/*.test.jsx",
        "src/**/*.spec.jsx"
    ],
    "extends": "./tsconfig.json",
    "include": ["src/**/*.ts"]
}
