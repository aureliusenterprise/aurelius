{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": ["aurelius-example", "aurelius-kafka", "aurelius-kafka-connect-jdbc-sink-base"],
    "name": "aurelius-kafka-connect-jdbc-sink-example",
    "projectType": "application",
    "tags": [],
