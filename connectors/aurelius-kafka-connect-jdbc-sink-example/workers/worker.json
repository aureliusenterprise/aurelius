{
    "batch.size": "200",
    "connection.password": "${file:/tmp/aurelius/env:CONFIG_DATABASE_PASSWORD}",
    "connection.url": "${file:/tmp/aurelius/env:CONFIG_DATABASE_URL}",
    "connection.username": "${file:/tmp/aurelius/env:CONFIG_DATABASE_USERNAME}",
    "connector.class": "io.debezium.connector.jdbc.JdbcSinkConnector",
    "consumer.override.group.id": "${file:/tmp/aurelius/env:CONFIG_CONSUMER_GROUP_NAME}",
    "delete.enabled": "true",
    "errors.deadletterqueue.context.headers.enable": "true",
    "errors.deadletterqueue.topic.name": "${file:/tmp/aurelius/env:CONFIG_DLQ_TOPIC_NAME}",
    "errors.deadletterqueue.topic.replication.factor": "1",
    "insert.mode": "upsert",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "key.converter.schemas.enable": "false",
    "primary.key.fields": "guid",
    "primary.key.mode": "record_key",
    "schema.evolution": "basic",
    "table.name.format": "${file:/tmp/aurelius/env:CONFIG_TABLE_NAME}",
    "tasks.max": "1",
    "topics": "${file:/tmp/aurelius/env:CONFIG_KAFKA_TOPIC_NAME}",
    "transforms": "hoist-primary-key,flatten",
    "transforms.flatten.delimiter": ".",
    "transforms.flatten.type": "org.apache.kafka.connect.transforms.Flatten$Value",
    "transforms.hoist-primary-key.field": "guid",
    "transforms.hoist-primary-key.type": "org.apache.kafka.connect.transforms.HoistField$Key",
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter.schema.registry.url": "${file:/tmp/aurelius/env:CONFIG_SCHEMA_REGISTRY_URL}",
    "value.converter.schemas.enable": "true",
    "value.converter.value.subject.name.strategy": "io.confluent.kafka.serializers.subject.RecordNameStrategy"
}
