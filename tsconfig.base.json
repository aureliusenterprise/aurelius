{
    "compileOnSave": false,
    "compilerOptions": {
        "declaration": false,
        "esModuleInterop": false,
        "experimentalDecorators": true,
        "ignoreDeprecations": "6.0",
        "importHelpers": true,
        "lib": ["es2022", "dom"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "noUncheckedSideEffectImports": false,
        "rootDir": ".",
        "skipDefaultLibCheck": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": false,
        "target": "es2015",
        "types": ["*"]
    },
    "exclude": ["node_modules", "tmp"]
}
