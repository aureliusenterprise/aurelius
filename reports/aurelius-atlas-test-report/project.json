{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "implicitDependencies": ["aurelius-atlas-testing"],
    "name": "aurelius-atlas-test-report",
    "projectType": "application",
    "sourceRoot": "{projectRoot}/aurelius_atlas_test_report",
    "tags": [],
    "targets": {
        "check": {
            "cache": false,
            "executor": "nx:run-commands",
            "metadata": {
                "description": "Fail when a public function or a specified rule is not named by a test (ADR 049)"
            },
            "options": {
                "command": "uv run python -m aurelius_atlas_testing.check --out reports/aurelius-atlas-test-report/dist/analysis.json"
            }
        },
        "render": {
            "cache": false,
            "executor": "nx:run-commands",
            "metadata": {
                "description": "Render the workspace test report from the results of the last test run"
            },
            "options": {
                "command": "uv run python -m aurelius_atlas_test_report --analysis reports/aurelius-atlas-test-report/dist/analysis.json"
            }
        }
    }
}
