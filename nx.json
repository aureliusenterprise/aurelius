{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "analytics": false,
    "defaultBase": "main",
    "namedInputs": {
        "default": ["{projectRoot}/**/*"],
        "production": ["default", "!{projectRoot}/src/test/**/*"]
    },
    "neverConnectToCloud": true,
    "plugins": [
        "./tools/plugins/alembic.ts",
        "./tools/plugins/docker.ts",
        "./tools/plugins/docker-compose.ts",
        "./tools/plugins/mkdocs.ts",
        "./tools/plugins/python.ts",
        "./tools/plugins/sonarqube.ts",
        "./tools/plugins/sops.ts",
        "./tools/plugins/sops-decrypt.ts",
        "./tools/plugins/sops-encrypt.ts",
        {
            "options": {
                "targetName": "eslint:lint"
            },
            "plugin": "@nx/eslint/plugin"
        }
    ],
    "release": {
        "changelog": {
            "workspaceChangelog": {
                "file": "docs/CHANGELOG.md",
                "renderOptions": {
                    "authors": false,
                    "commitReferences": true,
                    "versionTitleDate": true
                }
            }
        },
        "projects": ["*"],
        "version": {
            "conventionalCommits": true
        }
    },
    "targetDefaults": {
        "@nx/eslint:lint": {
            "cache": true,
            "inputs": ["default", "{workspaceRoot}/eslint.config.mjs"]
        }
    }
}
